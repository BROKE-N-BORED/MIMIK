[Desktop Entry]
Type=Application
Name=Install MIMIK
Comment=Install MIMIK (double-click, no terminal needed)
Exec=python3 -c "import os,subprocess,sys; d=os.path.dirname(sys.argv[1]) if len(sys.argv)>1 and sys.argv[1] else os.getcwd(); subprocess.call(['bash', os.path.join(d, 'install.sh')])" %k
Icon=system-software-install
Terminal=true
Categories=Development;
